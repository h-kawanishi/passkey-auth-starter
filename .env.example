# このファイルを .env にコピーして使う（.env はコミットしない）。
#   cp .env.example .env

# development / test / production。production では ORIGIN の https と SESSION_SECRET が必須になる
NODE_ENV=development

# 待ち受けるアドレスとポート。コンテナ内で動かすときは HOST=0.0.0.0
HOST=127.0.0.1
PORT=3000

# WebAuthn の RP ID（パスキーが紐づくドメイン）。ORIGIN のホスト名と同じか、その親ドメインにする
RP_ID=localhost
# 認証器のダイアログに表示されるサービス名
RP_NAME=passkey-auth-starter
# 画面を配信するオリジン（末尾の / なし）
ORIGIN=http://localhost:3000

# セッションの秘密（32 文字以上）。空なら開発時のみ起動ごとに使い捨ての値を作る。
# 本番では必ず設定する。生成例:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# SQLite のファイル。:memory: でメモリ上（終了で消える）
DATABASE_PATH=./data/app.sqlite

# fatal / error / warn / info / debug / trace / silent
LOG_LEVEL=info
